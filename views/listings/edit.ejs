<% layout('layouts/boilerplate') -%>
<body>
<form class="row g-3" method="POST" action="/listings/<%=listing._id%>?_method=PUT" enctype="multipart/form-data">
  <div class="col-md-6">
    <label for="inputtitle"  >Title</label>
    <input type="text" name="title" value="<%=listing.title%>" class="form-control" id="inputtitle" required>
  </div>
  <div class="col-md-6">
    <label for="inputPassword4" class="form-label">Price(&#8377)</label>
    <input type="text" class="form-control" value="<%=listing.price%>" name="price" id="inputPassword4" required>
  </div>
  <div class="col-12">
    <label for="inputAddress" class="form-label" >Description</label>
    <input type="text" class="form-control" value="<%=listing.description%>" id="inputAddress" name="description" placeholder="1234 Main St" required>
  </div>
  <div class="col-12">
    <label for="inputAddress2" class="form-label">Address</label>
    <input type="text" name="location" value="<%=listing.location%>" class="form-control" id="inputAddress2" placeholder="Apartment, studio, or floor" required>
  </div>
  <div class="previewImg">
    Original image<br>
    <img src="<%=originalImgUrl%>" style="height:100px; width:150px;">
  </div>
  <div class="col-md-6">
    <label for="inputCity" class="form-label">Upload new image</label>
    <input type="file" name="image" value="<%=listing.image.path%>" class="form-control" id="inputCity"  >
  </div>
  <div class="col-md-6">
    <label for="inputState" class="form-label">Country</label>
    <input type="text" name="country" value="<%=listing.country%>" class="form-control" id="inputCity" required>
  </div>
  <div class="col-12">
    <button type="submit" class="btn btn-danger">CONFIRM</button>
  </div>
</form>
</body>
