<% layout("layouts/boilerplate") -%>
<body>
 <style>
    .icons{
        display:flex;
        margin:2rem;

    }
    .icon{
        margin-right:2rem;
        text-align: center;
        opacity:0.7;
    }
    .icon:hover{
        opacity:1;
        cursor:pointer;
    }
    .tax-info{
        display:none;
    }
 </style>
<div class="icons mt-12">
    <div class="icon ">
        <i class="fa-solid fa-fire"></i>
        <p>Trending</p>
    </div>
    <div class="icon ">
            <div>
                <i class="fa-solid fa-bed"></i>
            </div>
        <p>Rooms</p>
    </div>
    <div class="icon ">
            <div>
                <i class="fa-solid fa-mountain"></i>
            </div>
        <p>Mountains</p>
    </div>
    <div class="icon ">
            <div>
                <i class="fa-solid fa-mountain-city"></i>
            </div>
        <p>Iconic cities</p>
    </div>
    <div class="icon ">
            <div>
                <i class="fa-brands fa-fort-awesome"></i>
            </div>
        <p>Castles</p>
    </div>
       <div class="icon ">
            <div>
                <i class="fa-solid fa-person-swimming"></i>
            </div>
        <p>Amazing pools</p>
    </div>
        <div class="icon ">
            <div>
                <i class="fa-solid fa-campground"></i>
            </div>
        <p>Camping</p>
    </div>
    <div class="icon ">
            <div>
                <i class="fa-solid fa-cow"></i>
            </div>
        <p>Farms</p>
    </div>
       <div class="icon ">
            <div>
                <i class="fa-solid fa-person-swimming"></i>
            </div>
        <p>Amazing pools</p>
    </div>
    <div class="form-check form-switch">
  <input class="form-check-input" type="checkbox" value="" id="checkNativeSwitch" switch>
  <label class="form-check-label" for="checkNativeSwitch">
    Display after taxes
  </label>
</div>
   
</div>    
    
<div class="cardstyle">
        <%for(list of allListings){%>
            <div class="card-single">
            <a href="/listings/<%=list._id%>">
            <div class="listing-card" >
                <img src="<%=list.image.path%>" class="card-img-top">
                   
            </div>
            <div class="card-details">
            <div class="card-body">
                        <p class="card-text"><b><%=list.title%></b></p>
            </div>
            <div class="card-price">
                        <p > &#8377 <%=list.price.toLocaleString("en-IN")%>/night &nbsp;&nbsp;<i class="tax-info">+18% GST</i></p>
                        
                        
            </div>
        </div>
            </a>
            </div>
            <!-- <a href="/listings/<%=list._id%>"></a> -->
        <%}%>

</div>
<script>
    let taxSwitch = document.getElementById("checkNativeSwitch");
    taxSwitch.addEventListener("click",()=>{
       let is = document.querySelectorAll(".tax-info");
       console.log(is);
       for(i of is){
        if(i.style.display != "inline"){
            i.style.display="inline";
        }else{
            i.style.display="none";
        }
       }
    })
</script>

</body>


